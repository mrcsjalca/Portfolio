---
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>

    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #eaeaea;
    --text: #111111;
    --card-bg: #ffffff;
    --muted: #555555;
  }
  [data-theme="dark"] {
    --bg: #121212;
    --text: #eaeaea;
    --card-bg: #1e1e1e;
    --muted: #aaaaaa;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background-color: var(--bg);
    color: var(--text);
    transition: background-color .3s ease, color .3s ease;
    padding-top: 64px; /* altura real del header, ajusta si hace falta */
  }
    
    .container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 2rem;
}
</style>