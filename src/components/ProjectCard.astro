---
const { nombre, descripcion, enlace, imagen, stack } = Astro.props;
---
<a href={enlace} target="_blank" class="card">
  <img src={`/images/${imagen}`} alt={nombre} />
  <div class="card-body">
    <h3>{nombre}</h3>
    <p>{descripcion}</p>
    <div class="tags">
      {stack?.map((tech) => <span class="tag">{tech}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
    background: var(--card-bg);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  }
  .card img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--bg);
  }
  .card-body {
    padding: 0.9rem;
  }
  .card-body h3 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
  }
  .card-body p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    border: 1px solid var(--muted);
  }
</style>