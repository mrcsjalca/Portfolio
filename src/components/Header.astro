---
<header class="header">
  <div class="header-inner">
    <!-- Logotipo / Identidad -->
    <a href="#" class="logo" aria-label="Ir al inicio">
      Marcos Jalca<span class="logo-accent">.</span>
    </a>

    <!-- Navegación por secciones del portfolio -->
    <nav class="section-nav" aria-label="Navegación principal">
      <a href="#sobremi" data-i18n="sobremi">Sobre mí</a>
      <a href="#tecnologias" data-i18n="tecnologias">Tecnologías</a>
      <a href="#proyectos" data-i18n="proyectos">Proyectos</a>
      <a href="#experiencia" data-i18n="experiencia">Experiencia</a>
      <a href="#contacto" data-i18n="contacto">Contacto</a>
    </nav>

    <!-- Controles de idioma y modo oscuro -->
    <div class="header-controls">
      <div class="lang-nav" role="group" aria-label="Selector de idioma">
        <button class="lang-btn" data-lang="es" aria-label="Cambiar idioma a Español">ES</button>
        <button class="lang-btn" data-lang="ca" aria-label="Canviar idioma a Català">CA</button>
        <button class="lang-btn" data-lang="en" aria-label="Switch language to English">EN</button>
      </div>

      <button id="theme-toggle" class="theme-btn" aria-label="Alternar modo claro / oscuro" title="Cambiar tema">
        <span class="theme-icon" id="theme-icon">🌙</span>
      </button>
    </div>
  </div>
</header>

<script>
  // ==========================================================================
  // EXPLICACIÓN TÉCNICA (i18n & Gestión de Tema en el Cliente):
  // 1. i18n reactivo: Leemos las traducciones de '../data/i18n.js'.
  //    Al pulsar un botón de idioma, recorremos cada elemento con [data-i18n],
  //    buscamos su clave en el diccionario y actualizamos textContent.
  //    Además guardamos la selección en 'localStorage' para recordarla entre visitas.
  // 2. Sincronización del Tema (Dark/Light):
  //    Comprobamos si document.documentElement.dataset.theme ya fue establecido
  //    por el script inline del <head> (prevención FOUC). Sincronizamos el icono
  //    (☀️ para tema oscuro, 🌙 para tema claro) y manejamos el clic.
  // ==========================================================================
  import { translations } from '../data/i18n.js';

  // --- GESTIÓN DEL TEMA OSCURO / CLARO ---
  const themeBtn = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');

  function updateThemeUI(theme) {
    if (themeIcon) {
      // Si el tema actual es oscuro, mostramos el sol para cambiar a claro, y viceversa
      themeIcon.textContent = theme === 'dark' ? '☀️' : '🌙';
    }
  }

  // Sincronizar el icono inicial según el tema ya aplicado en el <html>
  const initialTheme = document.documentElement.dataset.theme || 'light';
  updateThemeUI(initialTheme);

  themeBtn?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme;
    const next = current === 'dark' ? 'light' : 'dark';
    
    // Aplicamos el cambio al DOM y lo persistimos
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      console.warn('No se pudo guardar la preferencia de tema en localStorage', e);
    }
    
    // Micro-animación de giro al pulsar el botón
    themeBtn.classList.add('rotating');
    setTimeout(() => themeBtn.classList.remove('rotating'), 400);

    updateThemeUI(next);
  });

  // --- GESTIÓN DE IDIOMAS (i18n) ---
  const langButtons = document.querySelectorAll('.lang-btn');
  let savedLang = 'es';
  try {
    savedLang = localStorage.getItem('lang') || 'es';
  } catch (e) {
    savedLang = 'es';
  }

  function applyLang(lang) {
    if (!translations[lang]) return;

    // Recorremos todos los elementos que contengan texto traducible
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && translations[lang][key]) {
        el.textContent = translations[lang][key];
      }
    });

    // Actualizamos el atributo lang del documento para tecnologías de asistencia y SEO
    document.documentElement.lang = lang;
    try {
      localStorage.setItem('lang', lang);
    } catch (e) {}

    // Resaltamos el botón activo
    langButtons.forEach((b) => {
      b.classList.toggle('active', b.getAttribute('data-lang') === lang);
    });
  }

  // Aplicamos el idioma guardado al cargar
  applyLang(savedLang);

  // Escuchamos el clic en cada botón de idioma
  langButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (lang) applyLang(lang);
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    /* Efecto Glassmorphism (difuminado translúcido de fondo) */
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .header-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.5rem;
    gap: 1rem;
  }

  .logo {
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo-accent {
    color: var(--primary);
  }

  .section-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .section-nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
    padding: 0.25rem 0;
  }

  .section-nav a:hover {
    color: var(--text);
  }

  /* Subrayado animado al hacer hover en los enlaces del menú */
  .section-nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--primary);
    transition: width 0.25s ease;
    border-radius: 1px;
  }

  .section-nav a:hover::after {
    width: 100%;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-nav {
    display: flex;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .lang-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .lang-btn:hover {
    color: var(--text);
  }

  .lang-btn.active {
    background: var(--text);
    color: var(--bg);
  }

  .theme-btn {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.35rem 0.65rem;
    cursor: pointer;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .theme-btn:hover {
    transform: scale(1.05);
    border-color: var(--muted);
  }

  .theme-btn.rotating {
    transform: rotate(360deg) scale(1.1);
    transition: transform 0.4s ease;
  }

  /* Adaptación responsive para dispositivos móviles */
  @media (max-width: 768px) {
    .header-inner {
      padding: 0.75rem 1rem;
    }
    .section-nav {
      gap: 0.75rem;
    }
    .section-nav a {
      font-size: 0.8rem;
    }
    .logo {
      font-size: 1rem;
    }
  }

  @media (max-width: 580px) {
    .section-nav {
      display: none; /* En pantallas muy pequeñas simplificamos para no apiñar */
    }
  }
</style>