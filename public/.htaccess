# ============================================================================
# CONFIGURACIÓN DE SERVIDOR APACHE (InfinityFree)
# ============================================================================

# Forzar que el archivo principal sea index.html
DirectoryIndex index.html

# Asegurar tipos MIME modernos para módulos JavaScript y estilos
AddType application/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg

# Activación de compresión para acelerar la carga en conexiones móviles
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Caché en navegador para archivos estáticos inmutables generados por Astro
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
